# Console sign-in (SpacetimeAuth). Both are compiled in at build time. Register <origin>/callback as a redirect URI.
VITE_SPACETIMEAUTH_CLIENT_ID=
# VITE_SPACETIMEAUTH_AUTHORITY=https://auth.spacetimedb.com/oidc
# Voice agent (see ui/README.md). Copy to .env; .env is gitignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_API_KEY=      # used instead when GEMINI_API_KEY is empty, or when LLM_PROVIDER=claude
ELEVENLABS_API_KEY=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
