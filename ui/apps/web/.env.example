# Better Auth (console sign-in)
BETTER_AUTH_SECRET=        # openssl rand -base64 32. Required in production.
BETTER_AUTH_URL=http://localhost:3001
AUTH_DB_PATH=./data/auth.db
# Voice agent (see ui/README.md). Copy to .env; .env is gitignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_API_KEY=      # used instead when GEMINI_API_KEY is empty, or when LLM_PROVIDER=claude
ELEVENLABS_API_KEY=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Mana workspace API key: building research and the mission log in Mana (see src/server/mana.ts)
MANA_API_KEY=
